{
  "name": "mdui-tui",
  "version": "0.1.0",
  "description": "A Bun/OpenTUI terminal Markdown renderer with finder, vim-style navigation, copy helpers, and PDF export.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.4",
  "bin": {
    "mdui": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun --bun node_modules/vitest/vitest.mjs run",
    "prepack": "bun \"node_modules/typescript/bin/tsc\" -p tsconfig.json",
    "start": "bun run src/cli.ts",
    "dev": "bun run src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaronjo03/mdui-tui.git"
  },
  "bugs": {
    "url": "https://github.com/Aaronjo03/mdui-tui/issues"
  },
  "homepage": "https://github.com/Aaronjo03/mdui-tui#readme",
  "keywords": [
    "markdown",
    "terminal",
    "tui",
    "opentui",
    "bun",
    "vim"
  ],
  "author": "Aaron J",
  "dependencies": {
    "@opentui/core": "0.2.0",
    "marked": "18.0.2",
    "slackify-markdown": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "bun-types": "1.3.13",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
